# Copy to deploy/.env and fill in. `docker compose -f deploy/compose.yaml up -d` reads it.
#
# The file holds secrets, so it is not in git: deploy/.env is ignored.

# Signs every reader link (tracking, unsubscribe, confirm, keep). At least 32 characters, and
# rotating it breaks the links in emails that have already been sent.
#   openssl rand -base64 48
SESSION_SECRET=

# Where the deployment answers. Every link in every email is built from this, so it has to be the
# address a reader can reach: https://news.example.com, not an internal name.
APP_URL=

# The domain caddy gets a certificate for. A bare hostname in production; leave it as the default
# only for a local run.
SITE_ADDRESS=news.example.com

# Sending is off until this says otherwise. The pre-send checks refuse a send when it is false, which
# is what makes a fresh deployment safe to start.
SENDING_ENABLED=false

# The region the SES client talks to. Required once sending is on.
SES_REGION=
# AWS credentials. On EC2/ECS the instance or task role is used instead and these stay empty.
# The IAM policy needs four actions and no more — ses:SendEmail, ses:GetEmailIdentity,
# ses:ListEmailIdentities, ses:GetAccount; the minimal policy is in docs/ses-smoke.md. Without
# ses:GetAccount a deployment still sends, but one email a second (see SEND_RATE_HEADROOM below).
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# The configuration set whose SNS topic reports delivery, bounces and complaints.
SES_CONFIGURATION_SET=
# The topic the webhook accepts. Anything else is refused with a 403.
SES_SNS_TOPIC_ARN=

# The archive's own hostnames, "<host>=<newsletter-slug>", comma separated. Optional: without it the
# archive lives at APP_URL/archive/<slug>.
ARCHIVE_HOSTS=

# Where the MCP endpoint listens, inside the container. It is not published by compose: an agent
# reaches it with `docker compose exec nibwire nibwire mcp --stdio`, or by forwarding the port
# deliberately. That is the point — it is the admin surface, and caddy fronts the reader side.
MCP_HTTP_ADDR=127.0.0.1:8081

# Where alerts go (phase 7): needs ALERT_FROM on a verified domain.
ALERT_FROM=
ADMIN_EMAIL=

# The networks whose X-Forwarded-For may be believed. caddy is the only thing that can reach the app
# container, so its forwarded address is the reader's; without this every reader shares one
# rate-limit bucket. 172.16.0.0/12 is docker's default bridge pool — put your own network's subnet
# here if compose was given one.
TRUSTED_PROXIES=172.16.0.0/12

# How many messages are in flight at once. The rate follows the account (SES's own MaxSendRate, less
# a tenth), and what a deployment needs is enough workers to reach it: the number is the rate times
# how long one send takes, so 450 a second against 80 ms of latency needs at least 36. Too few and
# the account's allowance goes unused; `nibwire quota` prints the rate this deployment is aiming at.
SEND_CONCURRENCY=16

# The fraction of the account's rate to aim at. Sending at exactly the account's limit means every
# rounding error and every other client of the same account lands on a throttle; a tenth of it is
# cheap insurance. It can be raised to 1.0 by an account that wants to live closer to its limit.
SEND_RATE_HEADROOM=0.9

# A ceiling of your own, in sends a second. Leave it empty: the rate follows the account's own
# numbers, and this can only lower them. Set it when something other than SES is the limit — a
# shared reputation, an agreement with a client — and not as a substitute for reading the account.
SEND_RATE_PER_SECOND=

# The day's sending budget across every campaign and every credential, as a whole number.
MAX_SENDS_PER_DAY=50000

# A local stack adds SES_ENDPOINT and dummy credentials in deploy/compose.local.yaml instead; do not
# put them here.
