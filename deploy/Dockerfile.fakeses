# The fake SES, as its own image. It is never part of the production stack: deploy/compose.local.yaml
# adds it, and only the smoke script uses that file.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -buildid=" -o /out/fakeses ./cmd/fakeses

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/fakeses /usr/local/bin/fakeses
EXPOSE 8080
ENTRYPOINT ["fakeses"]
