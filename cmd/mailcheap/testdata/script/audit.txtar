# audit list：每次写与每次发送都留一行。

mailcheap init
exists mailcheap.db

mailcheap audit list
stdout '0 entries'

mailcheap newsletter create --name 'Field notes' --slug field-notes --from-name 'Jane Doe' --from-email jane@example.net --postal-address '1 Main St, Paris'
mailcheap newsletter update field-notes --name 'Field Notes Weekly'
mailcheap contact add reader@example.com --newsletter field-notes
mailcheap suppression add noisy@example.com --reason manual
mailcheap credentials create --kind api --name site --scopes read
mailcheap campaign create --newsletter field-notes --subject 'Issue 12' --file issue.md
mailcheap campaign test --subject 'Issue 12' --to checker@example.com

mailcheap audit list
stdout 'newsletter.create'
stdout 'newsletter.update'
stdout 'contact.add'
stdout 'suppression.add'
stdout 'credential.create'
stdout 'campaign.create'
stdout 'campaign.test'

# 凭据的 token 不进审计。明文只出现一次，而且不是在这里。
mailcheap audit list
! stdout 'mc_[A-Za-z0-9_-]{43}'

mailcheap audit list --action campaign.test --json
stdout '"Action": "campaign.test"'
stdout '"ActorKind": "cli"'
stdout '"ParamsDigest": "'

# 换个 action 就没有别的行了。
mailcheap audit list --action campaign.test
stdout '1 entries'
mailcheap audit list --actor api
stdout '0 entries'

-- issue.md --
# Hello

Read [this](https://example.com).
