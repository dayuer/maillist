# domains、db、health、approve 四条命令。
#
# domains reads the stand-in identity list: nothing in this repository talks to AWS.

env MAILCHEAP_FAKE_SES_DOMAINS=example.net,other.example
mailcheap init
exists mailcheap.db

# --- domains ------------------------------------------------------------------------------------
mailcheap domains
stdout 'example.net   verified'
stdout 'DKIM SUCCESS'
mailcheap domains --json
stdout '"Domain": "other.example"'
stdout '"VerifiedForSend": true'

# --- health -------------------------------------------------------------------------------------
mailcheap health
stdout '^ok\n$'
mailcheap health --json
stdout '"status": "ok"'

# --- db -----------------------------------------------------------------------------------------
mailcheap db migrate
stdout 'migration\(s\) applied'
stdout '0001_init.sql'
stdout '0002_serve_heartbeat.sql'
stdout '0003_uploads.sql'

mailcheap newsletter create --name 'Field notes' --slug field-notes --from-email jane@example.net --postal-address '1 Main St, Paris'
mailcheap db backup --to snapshot.db
stdout 'backed up to snapshot.db'
exists snapshot.db

# 改一点东西，再恢复回去。
mailcheap newsletter create --name 'Second' --slug second --from-email jane@example.net --postal-address '1 Main St, Paris'
mailcheap newsletter list
stdout 'second'
mailcheap db restore --from snapshot.db --yes
stdout 'restored'
# 覆盖前的旧库落在哪儿，输出里就有（testscript 没有 glob，所以断言那一行）。
stdout 'the previous file is at .*mailcheap\.db\.bak-'
mailcheap newsletter list
! stdout 'second'
stdout 'field-notes'

# 而 -wal/-shm 不会被留下：旧日志重放到恢复后的库上会得到混合状态。
exists mailcheap.db
! exists mailcheap.db-wal
! exists mailcheap.db-shm

# 不是数据库的文件不能当备份。
! mailcheap db restore --from issue.md --yes
stderr 'is not a database'

# --- approve ------------------------------------------------------------------------------------
# 没有在等批准的 job 时，approve 说清楚它是什么状态。
mailcheap campaign create --newsletter field-notes --subject 'Issue 12' --file issue.md
mailcheap campaign schedule --subject 'Issue 12' --at 'in 2h'
stdout 'scheduled'
! mailcheap approve 000000000000000000000000
stderr 'no job'

-- issue.md --
# Hello

Read [this](https://example.com).
