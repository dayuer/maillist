# 阶段 2 的完成标志：一个二进制、一个 SQLite 文件，把一封 campaign 发完。
# 假 SES 记录每一次发送到 $MAILCHEAP_FAKE_SES_LOG。

mailcheap init
exists mailcheap.db

mailcheap newsletter create --name 'Field notes' --slug field-notes --from-name 'Jane Doe' --from-email jane@example.net --postal-address '1 Main St, Paris' --archive-enabled
stdout '^[0-9a-f]{24}\n$'
mailcheap newsletter list
stdout 'field-notes'

mailcheap contact add reader@example.com --newsletter field-notes
stdout '^[0-9a-f]{24}\n$'

# 第二个联系人，用来确认是群发而不是单发。
mailcheap contact add other@example.com --newsletter field-notes

mailcheap campaign create --newsletter field-notes --subject 'Issue 12' --file issue.md --preview-text 'This week'
stdout '^[0-9a-f]{24}\n$'

mailcheap campaign list
stdout 'draft\tIssue 12'

# 发送：--yes 跳过确认。
mailcheap campaign send --subject 'Issue 12' --yes
stdout 'queued 2 recipients'

# 假 SES 恰好收到两封，收件人正确，带上了 message_id 与 kind 标签。
exists sent.jsonl
grep '"to":"reader@example.com"' sent.jsonl
grep '"to":"other@example.com"' sent.jsonl
grep '"kind":"campaign"' sent.jsonl
! grep '"to":"third@example.com"' sent.jsonl

# campaign 落成 sent，统计里有两次发送。
mailcheap campaign list --json
stdout '"Status": "sent"'

-- issue.md --
# Hello

Read [this](https://example.com).
