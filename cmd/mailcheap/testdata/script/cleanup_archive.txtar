# 名单清理与归档页：CLI 一侧的端到端。
#
# 清理默认关闭；打开之后，冷联系人拿到 last-chance 而不是这一期，而 --run 会把过了窗口的人置为
# dormant。归档页要能被渲染出来（页面本身在 httpsrv 的单测里测，这里测的是 CLI 把数据摆对了）。

mailcheap init
mailcheap newsletter create --name 'Field notes' --slug field-notes --from-name 'Jane Doe' --from-email jane@example.net --postal-address '1 Main St, Paris' --archive-enabled
stdout '^[0-9a-f]{24}\n$'

# 清理关着的时候，报告说的是「每个人都拿到这一期」。
mailcheap cleanup
stdout 'cleanup is off: everyone gets every issue'

mailcheap contact add reader@example.com --newsletter field-notes
mailcheap contact add quiet@example.com --newsletter field-notes

# 打开清理，并把 quiet 弄成一个「冷」的人：忽略的期数与久无动静都要够。
mailcheap newsletter update field-notes --cleanup-enabled --cleanup-issues 2 --cleanup-days 30
mailcheap contact show quiet@example.com --newsletter field-notes --json
stdout '"IgnoredIssues": 0'

# 发一期：两个人都在受众里，这一次没人该拿到 last-chance（刚加入）。
mailcheap campaign create --newsletter field-notes --subject 'Issue 12' --file issue.md
mailcheap campaign send --subject 'Issue 12' --yes
stdout 'queued 2 recipients'

# 报告：这一期没有 last-chance 的那一列，因为没有人冷。
mailcheap campaign report --subject 'Issue 12'
stdout 'last-chance'

# 预览是只读的：它报出设置与「下一个发送会做什么」。
mailcheap cleanup --newsletter field-notes
stdout 'settings  2 issues, 30 days'
stdout 'recipients'
stdout 'nothing was written'

mailcheap cleanup --newsletter field-notes --json
stdout '"enabled": true'
stdout '"moved": 0'

# --run 在没有过期联系人时也不该动任何人。
mailcheap cleanup --newsletter field-notes --run
stdout 'moved 0 to dormant'

-- issue.md --
# Hello

Read [this](https://example.com/read).
