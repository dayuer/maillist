# contact import: a provider's CSV export, twice, with the phase-2 invariants on top.
#
# Phase 2 requires two things of this path: a second import refreshes the imported engagement
# history of the contacts it already has, and a status only ever moves stricter. Both are asserted
# here from the CLI.

nibwire init
exists nibwire.db
nibwire newsletter create --name 'Field notes' --slug field-notes --from-name 'Jane Doe' --from-email jane@example.net --postal-address '1 Main St, Paris'
stdout '^[0-9a-f]{24}\n$'

# A dry run decides without writing.
nibwire contact import exports.csv --newsletter field-notes --dry-run
stdout 'rows 3  created 3  updated 0  skipped 1  suppressed 1'
nibwire contact list --newsletter field-notes
stdout '0 shown of 0'

# The real one.
nibwire contact import exports.csv --newsletter field-notes
stdout 'rows 3  created 3  updated 0  skipped 1  suppressed 1'
nibwire contact list --newsletter field-notes
stdout '3 shown of 3'

# The imported history is what the audience ranking reads.
nibwire contact show reader@example.com --newsletter field-notes --json
stdout '"EmailsReceived": 40'

# A bounced row writes the global suppression (or: `suppression list` shows it, in the next script —
# the count above already says one was written), and the contact joins bounced.
nibwire contact show bounce@example.com --newsletter field-notes
stdout 'status           bounced'

# Second import: nothing is created, and every contact the file names is refreshed — `updated` counts
# the refreshes, not status changes, because the imported history is rewritten either way. The
# statuses do not move back, and the row that says "active" for a bounced address writes no new
# suppression (the existing one stands).
nibwire contact import exports_updated.csv --newsletter field-notes
stdout 'rows 3  created 0  updated 3  skipped 1  suppressed 0'
nibwire contact show reader@example.com --newsletter field-notes --json
stdout '"EmailsReceived": 52'
stdout '"OpenRate": 0.55'

# ...and a row that says "active" does not bring a bounced contact back.
nibwire contact show bounce@example.com --newsletter field-notes --json
stdout '"Status": "bounced"'

# The export round-trips: exporting and importing the same file changes nothing.
nibwire contact export --newsletter field-notes --out roundtrip.csv
nibwire contact import roundtrip.csv --newsletter field-notes
stdout 'created 0'

# A file with no email column is refused rather than imported as nothing.
! nibwire contact import headless.csv --newsletter field-notes
stderr 'no email column'

# A file that lists an address twice collapses to one contact, keeping the strictest status.
nibwire contact import duplicates.csv --newsletter field-notes
stdout 'rows 1  created 1'
nibwire contact show twice@example.com --newsletter field-notes
stdout 'status           unsubscribed'

-- exports.csv --
email,status,created_at,emails_received,open_rate,click_rate
reader@example.com,active,2026-01-15,40,0.4,0.1
second@example.com,subscribed,2026-02-20,12,0.3,0.05
bounce@example.com,bounced,2026-03-01,3,0.0,0.0
not-an-address,active,2026-03-02,1,0.0,0.0

-- exports_updated.csv --
email,status,created_at,emails_received,open_rate,click_rate
reader@example.com,active,2026-01-15,52,0.55,0.12
second@example.com,active,2026-02-20,12,0.3,0.05
bounce@example.com,active,2026-03-01,3,0.0,0.0
not-an-address,active,2026-03-02,1,0.0,0.0

-- headless.csv --
name,joined
Jane,2026-01-01

-- duplicates.csv --
email,status,created_at
twice@example.com,active,2026-04-01
twice@example.com,unsubscribed,2026-04-01
