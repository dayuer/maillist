# credentials create|list|revoke：明文只出现一次，之后任何命令都拿不回它。

nibwire init
exists nibwire.db

nibwire credentials list
! stdout 'mc_'

nibwire credentials create --kind api --name site --scopes read,write --daily-budget 2000
stdout '^mc_[A-Za-z0-9_-]{43}$'
stdout 'kind api'
stdout 'scopes read,write'
stdout 'daily budget 2000'
stdout 'shown once'

# 列表能看到它，但看不到 token 本身：只有前缀。
nibwire credentials list
stdout 'api\tsite'
stdout 'read,write'
stdout 'active'
! stdout 'mc_[A-Za-z0-9_-]{43}'

# JSON 里的 token 也是唯一一次。
nibwire credentials create --kind mcp --name bot --json
stdout '"token": "mc_'
stdout '"scopes": \['
stdout '"read"'

# 参数的把关。
! nibwire credentials create --kind wrong --name x
stderr 'must be api or mcp'
! nibwire credentials create --kind api --name x --scopes admin
stderr 'unknown scope "admin"'
! nibwire credentials create --kind api --name x --daily-budget -1
stderr 'cannot be negative'

# 撤销按前缀也能找到。
nibwire credentials list --json
stdout '"Prefix": "mc_'
nibwire credentials revoke site
stdout 'revoked '
nibwire credentials list
stdout 'revoked'
! nibwire credentials revoke site
stderr 'already revoked'
! nibwire credentials revoke mc_0000000000
stderr 'not found'
